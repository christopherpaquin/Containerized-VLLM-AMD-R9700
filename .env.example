# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# .env is gitignored — real values (e.g. a Hugging Face token) never get committed.
# Model-specific settings (context length, GPU memory utilization, quantization, ...)
# live in config/models/*.env, not here. See docs/MODELS.md.

# ---------------------------------------------------------------------------
# Default model profile
# ---------------------------------------------------------------------------
# Used by `scripts/start.sh` when no profile is given on the command line.
# Qwen3-Coder-30B-A3B is the primary target model for this deployment — see
# docs/MODELS.md. `scripts/start.sh qwen25-coder-14b` (or any other profile
# name) still always works explicitly regardless of this default.
DEFAULT_MODEL_PROFILE=qwen3-coder-30b-a3b

# ---------------------------------------------------------------------------
# vLLM container image
# ---------------------------------------------------------------------------
# Official AMD ROCm vLLM image, pinned. Built for RDNA GPUs (includes gfx1201 /
# Radeon AI PRO R9700). See docs/ROCM.md for why this image was chosen and
# what to try if it fails to start on this specific GPU.
VLLM_IMAGE=rocm/vllm:rocm7.14.0_rdna_ubuntu24.04_py3.14_pytorch_2.11.0_vllm_0.23.0

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
# Port the OpenAI-compatible API is published on (host and container).
API_PORT=8000

# Bind address for the published port. 0.0.0.0 makes the API reachable from
# the LAN (the default for this project — see README "Security" section).
# Set to 127.0.0.1 to restrict access to this host only.
API_BIND_ADDRESS=0.0.0.0

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Host directory where downloaded model weights are cached. Must have enough
# free space for whichever models you download (tens of GB each). Persisted
# across container restarts/upgrades; never deleted automatically.
HF_CACHE_DIR=${HOME}/.cache/huggingface

# Host directory for vLLM's own cache (torch.compile / graph compilation
# cache). Persisting this avoids repeating a multi-minute recompile on every
# container restart — measured on scar.lab at ~1 minute for the 14B profile,
# likely longer for the 30B profile.
VLLM_CACHE_DIR=${HOME}/.cache/vllm

# Optional: Hugging Face token, only needed for gated models. Leave empty for
# the models this project ships profiles for (Qwen Coder models are public).
# Never logged, never printed by any script in this repo.
HUGGING_FACE_HUB_TOKEN=

# ---------------------------------------------------------------------------
# Container behavior
# ---------------------------------------------------------------------------
CONTAINER_NAME=vllm
RESTART_POLICY=unless-stopped

# ---------------------------------------------------------------------------
# Host memory limit
# ---------------------------------------------------------------------------
# Hard cap on the container's host RAM (weights staged on CPU before GPU
# transfer, ROCm/PyTorch host buffers, shm for the API<->EngineCore worker
# IPC under ipc: host). Added after a real lockup on scar.lab: this
# container was observed steady-state at ~19.8 GiB with no limit set, and
# unconstrained host memory growth (across vllm + everything else running)
# triggered a kernel OOM-killer cascade that froze the box and required a
# hard power cycle. MEM_LIMIT gives headroom above the observed steady
# state; MEM_RESERVATION is the soft target the kernel reclaims toward
# under pressure before the hard limit is hit. Raise both if a larger model
# profile's steady-state usage exceeds this.
MEM_LIMIT=24g
MEM_RESERVATION=20g

# ---------------------------------------------------------------------------
# GPU device group access (usually not needed)
# ---------------------------------------------------------------------------
# The container joins the "video" and "render" groups (by name) to access
# /dev/kfd and /dev/dri. If those group names don't exist inside the image,
# or their GIDs don't match this host's, override with numeric GIDs here.
# scripts/preflight.sh prints this host's actual GIDs (getent group video/render).
# VIDEO_GID=44
# RENDER_GID=109
