# Model profile: Qwen2.5-Coder-14B-Instruct
#
# Lower-memory comparison/control model: dense 14B (not MoE), so its memory
# footprint is exactly what it looks like. Officially published AWQ weights
# (Qwen/Qwen2.5-Coder-14B-Instruct-AWQ) are used here rather than a
# third-party quantization.
#
# VRAM budget check:
#   - AWQ INT4 (~0.5 byte/param + overhead): ~8-9 GB weights, well inside the
#     ~23 GB budget (0.72 x 32 GB). Leaves substantially more headroom than
#     the 30B profile for KV cache / concurrency / longer context — this is
#     the point of using it as the comparison model. See docs/MODELS.md.
MODEL_ID=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ
SERVED_MODEL_NAME=qwen25-coder-14b

# More headroom than the 30B profile allows a larger baseline context; 32K is
# within this model's native (non-YaRN) context window.
MAX_MODEL_LEN=32768

# Same budget envelope as the 30B profile, for an apples-to-apples comparison
# in benchmarks. See docs/TUNING.md.
GPU_MEMORY_UTILIZATION=0.72

# Force the ROCm-compatible AWQ kernel path explicitly (see note in the 30B
# profile — avoid vLLM auto-selecting the CUDA-only "awq_marlin" path).
QUANTIZATION=awq

# Leave empty (vLLM default: KV cache dtype matches model compute dtype).
KV_CACHE_DTYPE=

# Explicit KV cache size in bytes (vLLM's --kv-cache-memory-bytes) — an
# alternative to GPU_MEMORY_UTILIZATION. Left empty; see the 30B profile's
# comment and docs/TUNING.md for why GPU_MEMORY_UTILIZATION is the default.
KV_CACHE_MEMORY_BYTES=

# Tool/function calling. Required for agentic coding tools (OpenCode, etc) —
# see the note in the 30B profile. "hermes" is vLLM's standard parser for
# Qwen2.5-Instruct-family tool calling.
EXTRA_VLLM_ARGS=--enable-auto-tool-choice --tool-call-parser hermes
